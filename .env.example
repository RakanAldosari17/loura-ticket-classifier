# Settings for the ticket classifier (section 11 of DESIGN.md).
# This file documents the environment variables; it is NOT loaded automatically.
# Every setting has a default, so the service runs with none of them set.
# Copy to .env for your own notes, or export the ones you want to change:
#   FAKE_FAILURE_RATE=0 uvicorn app.main:app

# Which model client to use: "fake" (default) or "anthropic".
MODEL_PROVIDER=fake

# API key for a real provider. Required only if MODEL_PROVIDER is not "fake".
# Leave this blank here and never commit a real key: this file is an example,
# and the service refuses to start with a provider set and no key.
MODEL_API_KEY=

# Which model to ask for, when MODEL_PROVIDER is "anthropic". The default is a
# small, cheap one, which is the right size for classifying a short ticket.
MODEL_NAME=claude-haiku-4-5

# Share of fake model replies that come back broken, 0.0 to 1.0.
# Set to 0 to get only valid replies (needed to reproduce section 15).
FAKE_FAILURE_RATE=0.1

# Number of background worker loops.
WORKER_COUNT=2

# How often an idle worker checks the database for a pending ticket, in seconds.
POLL_INTERVAL_SECONDS=1

# Timeout for one model call, in seconds.
MODEL_TIMEOUT_SECONDS=20

# Wait before the single retry after a model failure, in seconds.
RETRY_WAIT_SECONDS=2

# Where the SQLite database file lives.
DATABASE_PATH=./data/tickets.db
